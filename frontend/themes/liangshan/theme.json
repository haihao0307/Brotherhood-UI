  "dialogues": {
    "idle": {
      "speaker": "songjiang",
      "lines": [
        "梁山暂且无事，俺也去歇口气。",
        "四下还算太平，先让我缓缓神。",
        "眼下无甚急事，兄弟们各自安顿便是。",
        "风平浪静最好，俺也去先坐镇看着。",
        "若无差遣，俺也去先在此歇一歇。",
        "且先按兵不动，真有事再叫我不迟。",
        "大伙儿都安生些，俺也去也好喘口气。",
        "无令不动，无事不惊，这才像个样子。",
        "今日若能少出些乱子，俺也去便知足了。",
        "先稳着，莫要自乱阵脚。",
        "我在这儿看着，真有急报再来唤我。"
      ],
      "delayMs": 900
    },
    "writing": {
      "speaker": "songjiang",
      "lines": [
        "笔杆子还是得军师来。吴用，这回你上！",
        "这等落字成章的活儿，还得军师出手。",
        "我这嘴上说得热闹，真写下来还得靠吴用。",
        "要写得漂亮、说得明白，军师最拿手。",
        "纸上文章我不硬气，吴用，你来镇这个场。",
        "写字落款讲究体面，军师替我把关。",
        "这回要的是章法和分寸，吴用最懂。",
        "我只管定方向，落笔成文还得请军师。",
        "把这番话写顺、写透，方能服人，吴用你来。",
        "嘴上交代容易，真成文书还得军师稳得住。"
      ],
      "delayMs": 1000
    },
    "researching": {
      "speaker": "songjiang",
      "lines": [
        "先别吵，让我把这事理一理。",
        "此事急不得，先把来龙去脉捋清。",
        "我先看看门道，再定下一步怎么走。",
        "线头这么多，总得先拣出个主次。",
        "先把局势看明白，省得一脚踩空。",
        "眼下最怕看漏一环，容我再细想想。",
        "这事表面简单，内里未必如此。",
        "且慢一步，先把关节处看透。",
        "真要下手，也得先知道刀该往哪儿落。",
        "不把底细摸清，贸然出手只会误事。"
      ],
      "delayMs": 900,
      "loopFirstDelayMinMs": 2800,
      "loopFirstDelayMaxMs": 4200,
      "loopIntervalMinMs": 6500,
      "loopIntervalMaxMs": 9500
    },
    "executing": {
      "speaker": "songjiang",
      "lines": [
        "这体力活儿我干不了！武松，你来干！",
        "要真刀真枪办事，还得武松出马！",
        "这事光说不顶用，武松，给我上手办了！",
        "该动手时就别讲虚的，武松你去压阵！",
        "这一步得有人硬着头皮顶上，武松，轮到你了！",
        "眼下不是磨嘴皮子的时候，武松，上！",
        "这桩事要落到实处，还得靠你这身胆气。",
        "谁能把这事一拳打实？自然是武松。",
        "莫再耽搁，叫武松把这事狠狠干成。",
        "真要拼手段和力气，梁山上还得看武松。"
      ],
      "delayMs": 1200
    },
    "syncing": {
      "speaker": "songjiang",
      "lines": [
        "队伍得整齐，流程得齐活。林冲，这事你盯着！",
        "前后要对上，消息要齐全，林冲，你去收一收。",
        "这事讲究一个稳字，林冲，替我把节奏理顺。",
        "散不得、乱不得，林冲，这一阵你来镇。",
        "把前后都接上，别漏一步，林冲你去看着。",
        "这事最怕脱节，林冲，你替我把链子拴紧。",
        "前军后队都要跟上，林冲，这活你最稳。",
        "但凡有一步接不上，后头就要乱，林冲去盯住。",
        "讲究秩序的时候，还得请林冲出来压一压。",
        "把这盘队伍带整齐，别叫人看了笑话。"
      ],
      "delayMs": 1000
    },
    "error": {
      "speaker": "songjiang",
      "lines": [
        "又出岔子了？鲁大师，先去把场子镇住！",
        "这回怕是要冒烟了，鲁大师，快去救火！",
        "坏了，锅要炸。鲁智深，先给我把场面按住！",
        "别让乱子再大了，鲁大师，你先顶上！",
        "这档子麻烦我看着都头疼，鲁智深，劳你出手！",
        "这口锅眼看压不住了，鲁大师，快去掀它回来！",
        "现在不是讲道理的时候，先把火头摁灭再说！",
        "乱成这样，再不请鲁大师，怕是真收不住。",
        "这麻烦越拖越大，鲁智深，立刻去镇场！",
        "先把人心稳住，再把烂摊子一并收拾了。"
      ],
      "delayMs": 1100
    }
  },
  "supportDialogues": {
    "default": {
      "firstDelayMinMs": 2500,
      "firstDelayMaxMs": 4000,
      "intervalMinMs": 6000,
      "intervalMaxMs": 12000,
      "minGapAfterMainMs": 2500
    },
    "wuyong": {
      "lines": [
        "这活不难，待我理出个章法来。",
        "笔墨交给我，哥哥只管放心。",
        "先把轻重缓急排好，省得白忙一场。",
        "越是乱，越要按章程来。",
        "话要说得透，字也得落得稳。",
        "让我先把条目列清，再慢慢铺开。",
        "不怕事多，就怕头绪不明。",
        "有些话要拐个弯说，才更服人。",
        "先定骨架，再填血肉，这文才立得住。",
        "这事不难，只是得拿捏分寸。",
        "能一句说清的，绝不用三句绕。",
        "让我斟酌斟酌，免得话到嘴边失了准头。"
      ]
    },
    "wusong": {
      "lines": [
        "说干就干，别磨蹭。",
        "这点阵仗，还不够我热身。",
        "谁拦路，我就先把谁办了。",
        "哥哥发了话，这事今天就得落地。",
        "手都热起来了，正好狠狠干一场。",
        "光站着看没用，真功夫还得落手上。",
        "这事要么不做，要做就给它做到底。",
        "真碰上硬骨头，我倒更来精神。",
        "别跟我说难，难也得给它办成。",
        "拳头要砸到实处，事情才算真推进。",
        "若是半途而废，倒不如一开始就别叫我来。",
        "能一步干完的事，我绝不拖到明天。"
      ]
    },
    "linchong": {
      "lines": [
        "莫急，我先把前后都对齐。",
        "队形一乱，事情就难办了。",
        "我盯着呢，差不了这一分一毫。",
        "先稳住节奏，再往下推。",
        "凡事一步一步来，乱了就容易漏。",
        "前后衔接最要紧，我先替你守住。",
        "只要节奏不散，这事就能顺下去。",
        "该接上的我来接，该补上的我来补。",
        "急归急，次序不能乱。",
        "队伍只要一稳，后头就好办得多。",
        "慢半拍不要紧，最怕的是乱了拍。",
        "我先把路铺平，再叫后面的人跟上。"
      ]
    },
    "luzhishen": {
      "lines": [
        "哪儿又炸锅了？洒家来收拾！",
        "先别慌，天塌不下来。",
        "有毛病就改，有麻烦就拆。",
        "这破事再闹，洒家可要动真格了。",
        "都闪开些，让洒家先把火压住。",
        "再乱也得有人兜底，这回我来。",
        "这点烂摊子，还不至于把人吓住。",
        "莫嚷莫嚷，洒家一来，天大的火也得压住。",
        "谁把事情搅成这样，待我先收拾局面。",
        "烂归烂，总有人得伸手去兜，这便是我了。",
        "这点风浪算什么，洒家见得多了。",
        "先把火灭了，再慢慢追究是谁惹的祸。"
      ]
    }
  },
